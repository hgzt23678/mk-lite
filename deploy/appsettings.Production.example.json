{
  "Federation": {
    "PublicBaseUri": "https://social.example.com",
    "ClientToServerEnabled": false,
    "RequireHttps": true,
    "AllowDevelopmentLoopback": false,
    "MaximumInboxBodyBytes": 2000000,
    "MaximumRemoteDocumentBytes": 2000000,
    "MaximumRedirects": 3,
    "MaximumFetchDepth": 4,
    "MaximumFetchesPerOperation": 16,
    "MaximumRecipientsPerActivity": 10000,
    "SignatureClockSkew": "00:05:00"
  },
  "Workers": {
    "InboxEnabled": false,
    "DeliveryEnabled": false,
    "BatchSize": 32,
    "LeaseDuration": "00:02:00",
    "HeartbeatInterval": "00:00:30",
    "MaximumInboxAttempts": 12,
    "MaximumDeliveryAttempts": 12,
    "MaximumConcurrentDeliveriesPerDomain": 2,
    "RawJsonRetentionEnabled": false,
    "ActivityRawJsonRetention": "90.00:00:00",
    "ObjectRawJsonRetention": "180.00:00:00",
    "RawJsonPurgeInterval": "01:00:00",
    "RawJsonPurgeBatchSize": 500
  },
  "Authentication": {
    "Authority": "https://identity.example.com",
    "Audience": "activitypub-api",
    "RequireHttpsMetadata": true
  },
  "OAuth": {
    "Enabled": true,
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshTokenReuseLeeway": "00:00:00",
    "InteractiveClientId": "activitypub-oauth-bridge",
    "InteractiveClientSecretFile": "/run/secrets/oauth-oidc-client-secret",
    "CallbackPath": "/auth/callback",
    "SigningCertificatePath": "/run/secrets/oauth-signing.pfx",
    "SigningCertificatePasswordFile": "/run/secrets/oauth-signing-password",
    "EncryptionCertificatePath": "/run/secrets/oauth-encryption.pfx",
    "EncryptionCertificatePasswordFile": "/run/secrets/oauth-encryption-password"
  },
  "MisskeyAuthentication": {
    "SessionLifetime": "00:15:00",
    "AccessTokenLifetime": "90.00:00:00"
  },
  "Redis": {
    "ConnectionString": "rediss://redis.internal.example.com:6380",
    "KeyPrefix": "activitypub-production",
    "DeliveryQueueChannel": "activitypub-production:delivery-wakeup",
    "InboxQueueChannel": "activitypub-production:inbox-wakeup",
    "TimelineCacheTtl": "00:00:03",
    "NotificationCountTtl": "00:00:10"
  },
  "Streaming": {
    "Redis": {
      "Channel": "activitypub-production:stream-events"
    }
  },
  "LocalAccounts": {
    "Enabled": true,
    "RegistrationEnabled": false,
    "RequireConfirmedEmail": true,
    "RequiredPasswordLength": 12,
    "MaximumFailedAccessAttempts": 5,
    "LockoutDuration": "00:15:00",
    "SessionLifetime": "08:00:00"
  },
  "RegistrationProtection": {
    "InvitationRequired": false,
    "InvitationLifetime": "7.00:00:00",
    "InvitationReservationLifetime": "00:05:00",
    "CaptchaProvider": "None",
    "CaptchaSiteKey": "",
    "CaptchaSecretFile": null,
    "CaptchaExpectedHostname": "",
    "CaptchaExpectedAction": "signup",
    "CaptchaExpectedCdata": "activitypub_signup",
    "CaptchaVerificationTimeout": "00:00:10"
  },
  "PasswordReset": {
    "Enabled": true,
    "SenderAddress": "no-reply@social.example.com",
    "SenderName": "social.example.com",
    "SmtpHost": "smtp.internal.example.com",
    "SmtpPort": 587,
    "TlsMode": "StartTls",
    "SmtpUsername": "activitypub",
    "SmtpPasswordFile": "/run/secrets/smtp-password",
    "TokenLifetime": "00:30:00",
    "RequestCooldown": "00:20:00",
    "EmailConfirmationTokenLifetime": "1.00:00:00",
    "EmailConfirmationRequestCooldown": "00:20:00",
    "SendTimeout": "00:00:15"
  },
  "Frontend": {
    "Enabled": true,
    "ClientId": "activitypub-web",
    "Scopes": [
      "openid",
      "profile",
      "offline_access",
      "activitypub.read",
      "activitypub.write"
    ],
    "SourceUrl": "https://git.example.com/fediverse/activitypub-server"
  },
  "KeyManagement": {
    "Enabled": true
  },
  "VaultTransit": {
    "Address": "https://vault.internal.example.com",
    "Mount": "transit",
    "TokenFile": "/run/secrets/vault-token"
  },
  "DataProtection": {
    "ApplicationName": "activitypub-server",
    "CertificatePath": "/run/secrets/data-protection.pfx",
    "CertificatePasswordFile": "/run/secrets/data-protection-password"
  },
  "Media": {
    "Enabled": true,
    "Provider": "CloudflareR2",
    "Bucket": "activitypub-production-media",
    "ServiceUrl": null,
    "Region": "auto",
    "ForcePathStyle": true,
    "UseServerSideEncryption": true,
    "CloudflareAccountId": "0123456789abcdef0123456789abcdef",
    "CloudflareJurisdiction": "Default",
    "ClamAvHost": "clamav.internal.example.com",
    "GarbageCollectionEnabled": false,
    "UnreferencedRetention": "30.00:00:00",
    "MaximumRemoteMediaBytes": 10000000,
    "RemoteMediaCacheRetention": "7.00:00:00",
    "RemoteMediaFetchLeaseDuration": "00:02:00",
    "RemoteMediaFetchLeaseRenewalInterval": "00:00:30",
    "RemoteMediaFetchWaitTimeout": "00:00:15",
    "RemoteMediaFailureRetryDelay": "00:05:00"
  },
  "Http": {
    "AllowedCorsOrigins": [
      "https://app.example.com"
    ],
    "TrustedProxies": [
      "10.20.0.10"
    ],
    "TrustedProxyNetworks": [],
    "Cloudflare": {
      "Enabled": true
    }
  },
  "AllowedHosts": "social.example.com"
}
