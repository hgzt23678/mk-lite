@page "/__test/components/user-list"
@rendermode InteractiveServer

<main data-contract="user-list-page">
    <button type="button" data-contract="reload" @onclick="ReloadAsync">reload</button>
    <MkUserList @ref="userList"
                Pagination="source"
                NoGap="true"
                class="contract-user-list"
                data-contract="user-list" />
</main>

@code {
    private readonly BrowserUserSource source = new();
    private MkUserList? userList;

    private Task ReloadAsync() => userList?.ReloadAsync() ?? Task.CompletedTask;

    private static UserPreviewViewModel User(string username, int ordinal) => new(
        Guid.Parse($"10000000-0000-0000-0000-{ordinal:D12}"),
        username,
        new NoteAuthorViewModel(
            username,
            username,
            $"{username}@remote.example",
            char.ToUpperInvariant(username[0]) + username[1..],
            "/static-assets/user-unknown.png",
            IsBot: false,
            OnlineStatus: "unknown"),
        string.Empty,
        null,
        NotesCount: ordinal,
        FollowingCount: ordinal + 1,
        FollowersCount: ordinal + 2,
        IsLocked: false,
        CanFollow: false,
        IsFollowing: false,
        HasPendingFollowRequestFromYou: false,
        IsFollowed: false);

    private sealed class BrowserUserSource : IMisskeyPaginationSource<UserPreviewViewModel>
    {
        private int initialRequests;

        public MisskeyPaginationOptions Options { get; } = new(Limit: 2);

        public ValueTask<IReadOnlyList<UserPreviewViewModel>> FetchAsync(
            MisskeyPaginationRequest request,
            CancellationToken cancellationToken)
        {
            cancellationToken.ThrowIfCancellationRequested();
            if (request.UntilId is not null)
            {
                return ValueTask.FromResult<IReadOnlyList<UserPreviewViewModel>>([User("carol", 3)]);
            }

            return Interlocked.Increment(ref initialRequests) == 1
                ? ValueTask.FromResult<IReadOnlyList<UserPreviewViewModel>>(
                [
                    User("alice", 1),
                    User("bob", 2),
                    User("sentinel", 99)
                ])
                : ValueTask.FromResult<IReadOnlyList<UserPreviewViewModel>>([User("bob", 2)]);
        }

        public string GetId(UserPreviewViewModel item) => item.Id;
    }
}
