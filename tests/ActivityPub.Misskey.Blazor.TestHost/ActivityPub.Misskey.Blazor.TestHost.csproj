<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Keep the production static-asset resolution path when App.razor comes from the frontend RCL. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../frontend/ActivityPub.Misskey.Blazor/ActivityPub.Misskey.Blazor.csproj" />
    <ProjectReference Include="../../frontend/ActivityPub.Misskey.Blazor.Server/ActivityPub.Misskey.Blazor.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../frontend/misskey-v12/public/static-assets/**/*"
             Link="wwwroot/static-assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../frontend/misskey-v12/public/client-assets/**/*"
             Link="wwwroot/client-assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
