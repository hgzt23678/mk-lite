# Local verification only. Generate fresh values; never reuse these placeholders in production.
AP_POSTGRES_PASSWORD=replace-with-random-local-password
AP_MINIO_ROOT_USER=replace-with-local-access-key
AP_MINIO_ROOT_PASSWORD=replace-with-random-local-secret
AP_VAULT_TOKEN=replace-with-random-local-vault-token
AP_VAULT_TOKEN_FILE=/absolute/path/to/a/file-containing-the-same-local-vault-token
AP_OIDC_ADMIN_PASSWORD=replace-with-random-local-admin-password
AP_OIDC_ALICE_PASSWORD=replace-with-random-local-alice-password
AP_OIDC_REALM_FILE=/absolute/path/outside-the-repository/to/pasture-realm.json
ACTIVITYPUB_PASTURE_PORT=2971
# Optional Tailnet-only frontend test listener. Existing Tailscale Serve routes are never replaced.
ACTIVITYPUB_TAILSCALE_PORT=9443
