<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AssemblyName>ActivityPub.Misskey.Blazor</AssemblyName>
    <RootNamespace>ActivityPub.Misskey.Blazor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MisskeyFrontendServiceCollectionExtensions.cs" />
    <Compile Remove="Localization/MisskeyFrontendLocalizationMiddleware.cs" />
    <Compile Remove="Localization/MisskeyLocaleRequestResolver.cs" />
    <Compile Remove="Localization/MisskeyLocalizer.cs" />
    <Compile Remove="Security/FrontendCspNonce.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/data/locales/catalog.json"
                      LogicalName="ActivityPub.Misskey.Blazor.LocaleCatalog.json" />
    <EmbeddedResource Include="wwwroot/themes/catalog.json"
                      LogicalName="ActivityPub.Misskey.Blazor.ThemeCatalog.json" />
    <EmbeddedResource Include="wwwroot/data/emojilist.json"
                      LogicalName="ActivityPub.Misskey.Blazor.EmojiList.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ActivityPub.Misskey.Blazor.Tests" />
    <InternalsVisibleTo Include="ActivityPub.Misskey.Blazor.Server" />
  </ItemGroup>
</Project>
