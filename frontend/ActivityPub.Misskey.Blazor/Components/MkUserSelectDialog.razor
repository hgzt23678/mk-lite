@implements IAsyncDisposable
@inject IUserSearchPresentationService Search
@inject IUserPreviewPresentationService Previews
@inject IPizzaxDeviceState DeviceState
@inject IMisskeyLocalizer Localizer

<MkModalWindow @ref="dialog"
               WithOkButton="true"
               OkButtonDisabled="@(selected is null)"
               Header="HeaderFragment"
               AccessibleLabel="@Localizer.Translate("selectUser")"
               OkLabel="@Localizer.Translate("ok")"
               CloseLabel="@Localizer.Translate("close")"
               Ok="OkAsync"
               Clicked="CancelAsync"
               Closed="ClosedAsync">
    <div class="tbhwbxda">
        <div class="form">
            <div class="form-split">
                <MkFormInput Value="@username"
                             ValueChanged="UsernameChangedAsync"
                             Autofocus="true"
                             Label="@UsernameLabel"
                             Prefix="@AtPrefix" />
                <MkFormInput Value="@host"
                             ValueChanged="HostChangedAsync"
                             Label="@HostLabel"
                             Prefix="@AtPrefix" />
            </div>
        </div>
        @if (username.Length > 0 || host.Length > 0)
        {
            <div class="result @(users.Count > 0 ? "hit" : null)">
                @if (users.Count > 0)
                {
                    <div class="users">
                        @foreach (UserPreviewViewModel user in users)
                        {
                            <button @key="user.Id"
                                    type="button"
                                    class="user @(selected?.Id == user.Id ? "selected" : null)"
                                    @onclick="() => SelectAsync(user)"
                                    @ondblclick="() => SelectAndConfirmAsync(user)">
                                <MkAvatar User="@user.User" ShowIndicator="true" CssClass="avatar" />
                                <span class="body">
                                    <MkUserName User="@user.User" CssClass="name" />
                                    <MkAcct User="@user.User" CssClass="acct" />
                                </span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="empty"><span>@Localizer.Translate("noUsers")</span></div>
                }
            </div>
        }
        else
        {
            <div class="recent">
                <div class="users">
                    @foreach (UserPreviewViewModel user in recentUsers)
                    {
                        <button @key="user.Id"
                                type="button"
                                class="user @(selected?.Id == user.Id ? "selected" : null)"
                                @onclick="() => SelectAsync(user)"
                                @ondblclick="() => SelectAndConfirmAsync(user)">
                            <MkAvatar User="@user.User" ShowIndicator="true" CssClass="avatar" />
                            <span class="body">
                                <MkUserName User="@user.User" CssClass="name" />
                                <MkAcct User="@user.User" CssClass="acct" />
                            </span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</MkModalWindow>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private MkModalWindow? dialog;
    private string username = string.Empty;
    private string host = string.Empty;
    private IReadOnlyList<UserPreviewViewModel> users = [];
    private IReadOnlyList<UserPreviewViewModel> recentUsers = [];
    private UserPreviewViewModel? selected;
    private long searchGeneration;

    [Parameter]
    public EventCallback<UserPreviewViewModel> Ok { get; set; }

    [Parameter]
    public EventCallback Cancel { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private RenderFragment HeaderFragment => builder =>
        builder.AddContent(0, Localizer.Translate("selectUser"));
    private RenderFragment UsernameLabel => builder =>
        builder.AddContent(0, Localizer.Translate("username"));
    private RenderFragment HostLabel => builder =>
        builder.AddContent(0, Localizer.Translate("host"));
    private RenderFragment AtPrefix => builder => builder.AddContent(0, "@");

    protected override async Task OnInitializedAsync()
    {
        IReadOnlyList<string> ids = await DeviceState.ReadAsync("recentlyUsedUsers", Array.Empty<string>(), lifetime.Token);
        var result = new List<UserPreviewViewModel>(Math.Min(ids.Count, 16));
        foreach (string id in ids.Take(16))
        {
            try
            {
                result.Add(await Previews.ReadAsync(id, lifetime.Token));
            }
            catch (UserPreviewPresentationException exception) when (exception.ErrorCode == "USER_PREVIEW_NOT_FOUND")
            {
            }
        }
        recentUsers = result;
    }

    private async Task UsernameChangedAsync(string value)
    {
        username = value.Trim();
        await SearchAsync();
    }

    private async Task HostChangedAsync(string value)
    {
        host = value.Trim();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        long generation = checked(++searchGeneration);
        if (username.Length == 0 && host.Length == 0)
        {
            users = [];
            selected = null;
            return;
        }

        string query = host.Length == 0 ? username : $"{username}@{host}";
        try
        {
            IReadOnlyList<UserPreviewViewModel> result = await Search.SearchAsync(query, "combined", 10, lifetime.Token);
            if (!lifetime.IsCancellationRequested && generation == searchGeneration)
            {
                users = result;
                selected = null;
            }
        }
        catch (UserPreviewPresentationException)
        {
            if (!lifetime.IsCancellationRequested && generation == searchGeneration)
            {
                users = [];
                selected = null;
            }
        }
    }

    private Task SelectAsync(UserPreviewViewModel user)
    {
        selected = user;
        return Task.CompletedTask;
    }

    private async Task SelectAndConfirmAsync(UserPreviewViewModel user)
    {
        selected = user;
        await OkAsync();
    }

    private async Task OkAsync()
    {
        if (selected is null)
        {
            return;
        }

        await Ok.InvokeAsync(selected);
        IReadOnlyList<string> previous = await DeviceState.ReadAsync("recentlyUsedUsers", Array.Empty<string>(), lifetime.Token);
        List<string> recents = previous.Where(id => !string.Equals(id, selected.Id, StringComparison.Ordinal)).ToList();
        recents.Insert(0, selected.Id);
        await DeviceState.WriteAsync("recentlyUsedUsers", recents.Take(16).ToArray(), lifetime.Token);
        if (dialog is not null)
        {
            await dialog.BeginCloseAsync();
        }
    }

    private async Task CancelAsync()
    {
        await Cancel.InvokeAsync();
        if (dialog is not null)
        {
            await dialog.BeginCloseAsync();
        }
    }

    private Task ClosedAsync() => Closed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        lifetime.Dispose();
    }
}
