@implements IAsyncDisposable
@inject INotificationToastInterop Browser
@inject IPizzaxDeviceState DeviceState

<div @ref="root" class="@RootClass" @attributes="AttributesWithoutClass">
    <MkNotification @ref="notificationComponent"
                    Notification="@Notification"
                    class="notification _acrylic" />
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private ElementReference root;
    private MkNotification? notificationComponent;
    private DotNetObjectReference<MkNotificationToast>? receiver;
    private IJSObjectReference? attachment;
    private bool? animation;
    private long generation;
    private bool closed;
    private bool disposed;

    [Parameter, EditorRequired]
    public NotificationViewModel Notification { get; set; } = null!;

    [Parameter]
    public EventCallback Closed { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(' ', new[] { "mk-notification-toast", AdditionalClass }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? AdditionalClass => AdditionalAttributes is not null &&
        AdditionalAttributes.TryGetValue("class", out object? value)
            ? Convert.ToString(value, CultureInfo.InvariantCulture)
            : null;

    private IReadOnlyDictionary<string, object>? AttributesWithoutClass => AdditionalAttributes is null
        ? null
        : AdditionalAttributes
            .Where(attribute => !string.Equals(attribute.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(attribute => attribute.Key, attribute => attribute.Value, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || attachment is not null || notificationComponent is null)
        {
            return;
        }

        if (animation is null)
        {
            try
            {
                animation = await DeviceState.ReadAsync("animation", true, lifetime.Token).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
            {
                return;
            }
            catch (JSDisconnectedException)
            {
                animation = true;
            }

            await InvokeAsync(StateHasChanged);
            return;
        }

        receiver ??= DotNetObjectReference.Create(this);
        long nextGeneration = checked(++generation);
        try
        {
            IJSObjectReference created = await Browser.AttachAsync(
                root,
                notificationComponent.Element,
                receiver,
                nextGeneration,
                animation.Value,
                lifetime.Token).ConfigureAwait(false);
            if (disposed)
            {
                await created.InvokeVoidAsync("dispose").ConfigureAwait(false);
                await created.DisposeAsync().ConfigureAwait(false);
                return;
            }

            attachment = created;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public async Task NotifyClosed(long callbackGeneration)
    {
        if (disposed || closed || callbackGeneration != generation)
        {
            return;
        }

        closed = true;
        await Closed.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        generation++;
        lifetime.Cancel();
        if (attachment is not null)
        {
            try
            {
                await attachment.InvokeVoidAsync("dispose").ConfigureAwait(false);
                await attachment.DisposeAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        receiver?.Dispose();
        lifetime.Dispose();
    }
}
