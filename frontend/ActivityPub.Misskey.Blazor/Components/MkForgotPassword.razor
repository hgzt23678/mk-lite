@implements IAsyncDisposable
@inject IMisskeyOverlayService Overlays
@inject IInstancePresentationService InstanceService
@inject IPasswordResetFormInterop PasswordResetInterop
@inject IMisskeyLocalizer Localizer

<MkModalWindow @ref="dialog"
               OverlayId="Id"
               Width="370"
               Height="400"
               AccessibleLabel="@Localizer.Translate("forgotPassword")"
               CloseLabel="@Localizer.Translate("close")"
               Closed="OnClosedAsync">
    <Header>@Localizer.Translate("forgotPassword")</Header>
    <ChildContent>
        @if (meta is null)
        {
            <div class="bafecedb" aria-busy="true"></div>
        }
        else if (meta.EnableEmail)
        {
            <form @ref="formElement"
                  class="bafeceda"
                  method="post"
                  action="/auth/password-reset/request">
                <AntiforgeryToken />
                <div class="main _formRoot">
                    <MkFormInput CssClassAdditional="_formBlock"
                                 Name="username"
                                 Type="text"
                                 Pattern="^[a-zA-Z0-9_]+$"
                                 Spellcheck="false"
                                 Autofocus="true"
                                 Required="true"
                                 ServerBound="false">
                        <Label>@Localizer.Translate("username")</Label>
                        <Prefix>@@</Prefix>
                    </MkFormInput>
                    <MkFormInput CssClassAdditional="_formBlock"
                                 Name="email"
                                 Type="email"
                                 Spellcheck="false"
                                 Required="true"
                                 ServerBound="false">
                        <Label>@Localizer.Translate("emailAddress")</Label>
                        <Caption>@Localizer.Translate("_forgotPassword.enterEmail")</Caption>
                    </MkFormInput>
                    @if (FailureMessage is string failureMessage)
                    {
                        <MkInfo Warn="true">@failureMessage</MkInfo>
                    }
                    <MkButton CssClassAdditional="_formBlock"
                              Type="submit"
                              Primary="true"
                              style="margin: 0 auto;"
                              data-password-reset-submit="true"
                              data-default-label="@SendLabel"
                              data-pending-label="@SendLabel">
                        @SendLabel
                    </MkButton>
                </div>
                <div class="sub">
                    <a href="about" class="_link">@Localizer.Translate("_forgotPassword.ifNoEmail")</a>
                </div>
            </form>
        }
        else
        {
            <div class="bafecedb">
                @Localizer.Translate("_forgotPassword.contactAdmin")
            </div>
        }
    </ChildContent>
</MkModalWindow>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private MkModalWindow? dialog;
    private ElementReference formElement;
    private DotNetObjectReference<MkForgotPassword>? receiver;
    private IJSObjectReference? attachment;
    private InstanceSummaryViewModel? meta;
    private string? failureMessageKey;
    private bool disposed;

    [CascadingParameter(Name = "MisskeyLocaleRevision")]
    private long LocaleRevision { get; set; }

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter]
    public EventCallback Done { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private string SendLabel => Localizer.Translate("send");

    private string? FailureMessage => failureMessageKey is null ? null : Localizer.Translate(failureMessageKey);

    protected override async Task OnInitializedAsync()
    {
        Overlays.RegisterCloseHandler(Id, BeginCloseAsync);
        meta = await InstanceService.GetAsync(lifetime.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || meta?.EnableEmail != true)
        {
            return;
        }

        receiver = DotNetObjectReference.Create(this);
        try
        {
            attachment = await PasswordResetInterop.AttachRequestAsync(formElement, receiver, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public async Task NotifyRequestAccepted()
    {
        await Done.InvokeAsync();
        await BeginCloseAsync();
    }

    [JSInvokable]
    public Task NotifyRequestFailure(string safeErrorCode)
    {
        failureMessageKey = safeErrorCode == "RATE_LIMIT_EXCEEDED"
            ? "rateLimitExceeded"
            : "error";
        return InvokeAsync(StateHasChanged);
    }

    private Task BeginCloseAsync() => dialog?.BeginCloseAsync() ?? Task.CompletedTask;

    private async Task OnClosedAsync()
    {
        await Closed.InvokeAsync();
        Overlays.Close(Id);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        Overlays.UnregisterCloseHandler(Id);
        await lifetime.CancelAsync();
        if (attachment is not null)
        {
            try
            {
                await attachment.InvokeVoidAsync("dispose");
                await attachment.DisposeAsync();
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }
        receiver?.Dispose();
        lifetime.Dispose();
    }
}
