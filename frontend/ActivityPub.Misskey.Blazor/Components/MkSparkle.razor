@implements IAsyncDisposable
@inject ISparkleInterop Browser
@inject IPizzaxDeviceState DeviceState

<span class="@RootClass" @attributes="AttributesWithoutClass">
    <span @ref="content">@ChildContent</span>
    @foreach (SparkleParticle particle in particles)
    {
        <svg @key="particle.Id"
             width="@Format(canvasWidth)"
             height="@Format(canvasHeight)"
             viewBox="0 0 @Format(canvasWidth) @Format(canvasHeight)"
             xmlns="http://www.w3.org/2000/svg"
             aria-hidden="true"
             focusable="false">
            <path style="transform-origin: center; transform-box: fill-box;"
                  transform="translate(@Format(particle.X) @Format(particle.Y))"
                  fill="@particle.Color"
                  d="M29.427,2.011C29.721,0.83 30.782,0 32,0C33.218,0 34.279,0.83 34.573,2.011L39.455,21.646C39.629,22.347 39.991,22.987 40.502,23.498C41.013,24.009 41.653,24.371 42.354,24.545L61.989,29.427C63.17,29.721 64,30.782 64,32C64,33.218 63.17,34.279 61.989,34.573L42.354,39.455C41.653,39.629 41.013,39.991 40.502,40.502C39.991,41.013 39.629,41.653 39.455,42.354L34.573,61.989C34.279,63.17 33.218,64 32,64C30.782,64 29.721,63.17 29.427,61.989L24.545,42.354C24.371,41.653 24.009,41.013 23.498,40.502C22.987,39.991 22.347,39.629 21.646,39.455L2.011,34.573C0.83,34.279 0,33.218 0,32C0,30.782 0.83,29.721 2.011,29.427L21.646,24.545C22.347,24.371 22.987,24.009 23.498,23.498C24.009,22.987 24.371,22.347 24.545,21.646L29.427,2.011Z">
                <animateTransform attributeName="transform"
                                  attributeType="XML"
                                  type="rotate"
                                  from="0 0 0"
                                  to="360 0 0"
                                  dur="@Duration(particle)"
                                  repeatCount="1"
                                  additive="sum" />
                <animateTransform attributeName="transform"
                                  attributeType="XML"
                                  type="scale"
                                  values="0; @Format(particle.Size); 0"
                                  dur="@Duration(particle)"
                                  repeatCount="1"
                                  additive="sum" />
            </path>
        </svg>
    }
</span>

@code {
    private static readonly string[] Colors = ["#FF1493", "#00FFFF", "#FFE202", "#FFE202", "#FFE202"];
    private readonly CancellationTokenSource lifetime = new();
    private readonly List<SparkleParticle> particles = [];
    private ElementReference content;
    private DotNetObjectReference<MkSparkle>? receiver;
    private IJSObjectReference? attachment;
    private CancellationTokenSource? particleLifetime;
    private Task? particleLoop;
    private double canvasWidth;
    private double canvasHeight;
    private long generation;
    private long particleGeneration;
    private bool? animationEnabled;
    private bool motionSuppressed = true;
    private bool disposed;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(' ', new[] { "mk-sparkle", AdditionalClass }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? AdditionalClass =>
        AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out object? value)
            ? Convert.ToString(value, CultureInfo.InvariantCulture)
            : null;

    private IReadOnlyDictionary<string, object>? AttributesWithoutClass => AdditionalAttributes is null
        ? null
        : AdditionalAttributes
            .Where(attribute => !string.Equals(attribute.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(attribute => attribute.Key, attribute => attribute.Value, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || attachment is not null)
        {
            return;
        }

        if (animationEnabled is null)
        {
            try
            {
                animationEnabled = await DeviceState.ReadAsync("animation", true, lifetime.Token);
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
            {
                return;
            }
            catch (JSDisconnectedException)
            {
                animationEnabled = true;
            }
        }

        receiver ??= DotNetObjectReference.Create(this);
        long nextGeneration = checked(++generation);
        try
        {
            IJSObjectReference created = await Browser.AttachAsync(
                content,
                receiver,
                nextGeneration,
                animationEnabled.Value,
                lifetime.Token);
            if (disposed)
            {
                await created.InvokeVoidAsync("dispose");
                await created.DisposeAsync();
                return;
            }

            attachment = created;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task UpdateSparkleMetrics(
        long callbackGeneration,
        double width,
        double height,
        bool reducedMotion)
    {
        if (disposed || callbackGeneration != generation ||
            !double.IsFinite(width) || !double.IsFinite(height) ||
            width is < 0 or > 100_000 || height is < 0 or > 100_000)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            canvasWidth = width + 64;
            canvasHeight = height + 64;
            if (motionSuppressed != reducedMotion)
            {
                motionSuppressed = reducedMotion;
                if (motionSuppressed)
                {
                    StopParticles();
                }
                else
                {
                    StartParticles();
                }
            }
            else if (!motionSuppressed && particleLoop is null)
            {
                StartParticles();
            }

            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        generation++;
        lifetime.Cancel();
        Task? runningParticles = particleLoop;
        StopParticles();
        if (runningParticles is not null)
        {
            try
            {
                await runningParticles;
            }
            catch (OperationCanceledException)
            {
            }
        }

        if (attachment is not null)
        {
            try
            {
                await attachment.InvokeVoidAsync("dispose");
                await attachment.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        receiver?.Dispose();
        particleLifetime?.Dispose();
        lifetime.Dispose();
    }

    private void StartParticles()
    {
        if (disposed || motionSuppressed || particleLoop is not null)
        {
            return;
        }

        particleLifetime?.Dispose();
        particleLifetime = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        long currentGeneration = checked(++particleGeneration);
        particleLoop = RunParticlesAsync(currentGeneration, particleLifetime.Token);
    }

    private void StopParticles()
    {
        particleGeneration++;
        particleLifetime?.Cancel();
        particleLoop = null;
        particles.Clear();
    }

    private async Task RunParticlesAsync(long currentGeneration, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && currentGeneration == particleGeneration)
            {
                SparkleParticle particle = CreateParticle();
                particles.Add(particle);
                StateHasChanged();
                _ = RemoveParticleAsync(particle.Id, particle.DurationMilliseconds - 100, currentGeneration, cancellationToken);
                int delay = 500 + Random.Shared.Next(501);
                await Task.Delay(delay, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (currentGeneration == particleGeneration)
            {
                particleLoop = null;
            }
        }
    }

    private async Task RemoveParticleAsync(
        string id,
        double delayMilliseconds,
        long currentGeneration,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(delayMilliseconds), cancellationToken);
            if (!disposed && currentGeneration == particleGeneration)
            {
                await InvokeAsync(() =>
                {
                    particles.RemoveAll(particle => particle.Id == id);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private SparkleParticle CreateParticle()
    {
        double factor = Random.Shared.NextDouble();
        return new(
            Guid.NewGuid().ToString("N"),
            Random.Shared.NextDouble() * Math.Max(0, canvasWidth - 64),
            Random.Shared.NextDouble() * Math.Max(0, canvasHeight - 64),
            0.2 + factor * 0.3,
            1_000 + factor * 1_000,
            Colors[Random.Shared.Next(Colors.Length)]);
    }

    private static string Format(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Duration(SparkleParticle particle) => $"{Format(particle.DurationMilliseconds)}ms";

    private sealed record SparkleParticle(
        string Id,
        double X,
        double Y,
        double Size,
        double DurationMilliseconds,
        string Color);
}
