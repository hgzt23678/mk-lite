@inject IAdminPresentationService Admin
@inject IMisskeyLocalizer Localizer
@inject IMisskeyOverlayService Overlays

<div class="_gaps">
    <section class="_panel _block" style="padding: 16px;">
        <h2 style="margin: 0 0 12px 0;">@Localizer.Translate("relays")</h2>
        @if (fetching)
        {
            <MkLoading />
        }
        else
        {
            <div class="_gaps">
                <div class="_formRoot" style="padding: 12px 0; border-bottom: solid 0.5px var(--divider);">
                    <MkFormInput CssClassAdditional="_formBlock" Value="@inbox" ValueChanged="@(value => { inbox = value; })" Type="url">
                        <Label>@Localizer.Translate("inboxUrl")</Label>
                    </MkFormInput>
                    <MkButton Primary="true" Disabled="@(adding || string.IsNullOrWhiteSpace(inbox))" OnClick="AddAsync">
                        <i class="fas fa-plus"></i> @Localizer.Translate("addRelay")
                    </MkButton>
                </div>
                @foreach (AdminRelayViewModel relay in relays)
                {
                    <div class="relaycxt _block" style="display: flex; gap: 12px; align-items: center; padding: 16px;">
                        <div style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@relay.Inbox</div>
                        <div class="status" style="display: flex; align-items: center; gap: 6px;">
                            @if (relay.Status == "accepted")
                            {
                                <i class="fas fa-check accepted" style="color: var(--accent);"></i>
                            }
                            else if (relay.Status == "rejected")
                            {
                                <i class="fas fa-ban rejected" style="color: #df4055;"></i>
                            }
                            else
                            {
                                <i class="fas fa-clock requesting"></i>
                            }

                            <span>@Localizer.Translate(RelayStatusKey(relay.Status))</span>
                        </div>
                        <MkButton Danger="true" Inline="true" OnClick="() => RemoveAsync(relay.Inbox)">
                            <i class="fas fa-trash-alt"></i> @Localizer.Translate("remove")
                        </MkButton>
                    </div>
                }
                @if (relays.Count == 0)
                {
                    <p style="opacity: 0.6;">@Localizer.Translate("none")</p>
                }
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<AdminRelayViewModel> relays = [];
    private bool fetching = true;
    private bool adding;
    private string inbox = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
        relays = await Admin.ListRelaysAsync(CancellationToken.None);
        fetching = false;
        }
        catch (ActivityPub.Misskey.Blazor.Identity.FrontendAuthenticationException exception)
        {
            Overlays.ShowSignIn("/admin", exception.ErrorCode);
        }
    }

    private async Task AddAsync()
    {
        if (adding)
        {
            return;
        }

        adding = true;
        try
        {
            await Admin.AddRelayAsync(inbox, CancellationToken.None);
            inbox = string.Empty;
            relays = await Admin.ListRelaysAsync(CancellationToken.None);
        }
        finally
        {
            adding = false;
        }
    }

    private async Task RemoveAsync(string relayInbox)
    {
        await Admin.RemoveRelayAsync(relayInbox, CancellationToken.None);
        relays = await Admin.ListRelaysAsync(CancellationToken.None);
    }

    private static string RelayStatusKey(string status) => status switch
    {
        "accepted" => "_relayStatus.accepted",
        "rejected" => "_relayStatus.rejected",
        _ => "_relayStatus.requesting"
    };
}
