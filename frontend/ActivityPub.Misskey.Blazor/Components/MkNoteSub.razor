@implements IAsyncDisposable
@inject IElementSizeInterop ElementSize

<div @ref="root" class="@RootClass" @attributes="AttributesWithoutClass">
    <div class="main">
        <MkAvatar CssClass="avatar" User="Note.Author" />
        <div class="body">
            <MkNoteHeader CssClass="header" Note="Note" Mini="true" />
            <div class="body">
                @if (Note.ContentWarning is not null)
                {
                    <p class="cw">
                        @if (Note.ContentWarning.Length > 0)
                        {
                            <MfmView CssClass="text" Text="@(Note.ContentWarning!)" CustomEmojis="Note.Emojis" />
                        }
                        <MkCwButton @bind-Expanded="showContent" Note="Note" />
                    </p>
                }
                <div class="content" style="@ContentVisibilityStyle">
                    <MkSubNoteContent class="text" Note="Note" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private ElementReference root;
    private DotNetObjectReference<MkNoteSub>? receiver;
    private IJSObjectReference? observation;
    private double width = double.PositiveInfinity;
    private bool showContent;
    private bool disposed;

    [Parameter, EditorRequired]
    public NoteViewModel Note { get; set; } = null!;

    [Parameter]
    public int Depth { get; set; } = 1;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(' ', new[]
    {
        "wrpstxzv",
        width <= 450 ? "max-width_450px" : null,
        Depth > 1 ? "children" : null,
        AdditionalClass
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? AdditionalClass => AdditionalAttributes is not null &&
        AdditionalAttributes.TryGetValue("class", out object? value)
            ? Convert.ToString(value, CultureInfo.InvariantCulture)
            : null;

    private IReadOnlyDictionary<string, object>? AttributesWithoutClass => AdditionalAttributes is null
        ? null
        : AdditionalAttributes
            .Where(attribute => !string.Equals(attribute.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(attribute => attribute.Key, attribute => attribute.Value, StringComparer.OrdinalIgnoreCase);

    private string? ContentVisibilityStyle => Note.ContentWarning is not null && !showContent
        ? "display: none;"
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        receiver = DotNetObjectReference.Create(this);
        try
        {
            observation = await ElementSize.ObserveAsync(root, receiver, lifetime.Token).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task UpdateElementSize(double nextWidth, int viewportWidth)
    {
        _ = viewportWidth;
        if (disposed || Math.Abs(width - nextWidth) < 0.5)
        {
            return Task.CompletedTask;
        }

        width = nextWidth;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        await lifetime.CancelAsync();
        if (observation is not null)
        {
            try
            {
                await observation.InvokeVoidAsync("dispose").ConfigureAwait(false);
                await observation.DisposeAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        receiver?.Dispose();
        lifetime.Dispose();
    }
}
