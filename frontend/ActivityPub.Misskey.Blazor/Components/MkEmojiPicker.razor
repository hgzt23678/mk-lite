@implements IAsyncDisposable
@inject IEmojiCatalog Catalog
@inject IPizzaxDeviceState DeviceState
@inject IEmojiPickerInterop EmojiInterop
@inject IMisskeyLocalizer Localizer

<div class="@RootClass" style="@RootStyle">
    <input @ref="search"
           class="search @(!string.IsNullOrEmpty(query) ? "filled" : null)"
           data-prevent-emoji-insert
           placeholder="@Localizer.Translate("search")"
           type="search"
           value="@query"
           @oninput="SearchChanged"
           @onkeyup="SearchKeyUp" />
    <div @ref="emojis" class="emojis">
        <section class="result">
            @if (searchResultCustom.Count > 0)
            {
                <div class="body">
                    @foreach (EmojiPickerCustomEmoji emoji in searchResultCustom)
                    {
                        @if (SameOriginMediaUrl.Normalize(emoji.Url) is { } emojiUrl)
                        {
                            <button @key="emoji.Name" class="_button item" title="@emoji.Name" tabindex="0" type="button" @onclick="eventArgs => ChooseCustom(emoji, eventArgs)">
                                <img class="emoji" src="@SelectCustomImageUrl(emojiUrl)" alt=":@emoji.Name:" decoding="async" />
                            </button>
                        }
                    }
                </div>
            }
            @if (searchResultUnicode.Count > 0)
            {
                <div class="body">
                    @foreach (UnicodeEmojiDefinition emoji in searchResultUnicode)
                    {
                        <button @key="emoji.Name" class="_button item" title="@emoji.Name" tabindex="0" type="button" @onclick="eventArgs => ChooseWithRipple(emoji.Value, eventArgs)">
                            <MkEmoji CssClass="emoji" Emoji="@emoji.Value" />
                        </button>
                    }
                </div>
            }
        </section>

        <div class="group index">
            @if (ShowPinned)
            {
                <section>
                    <div class="body">
                        @foreach (string emoji in EffectivePinned)
                        {
                            <button @key="emoji" class="_button item" tabindex="0" type="button" @onclick="eventArgs => ChooseWithRipple(emoji, eventArgs)">
                                <MkEmoji CssClass="emoji" Emoji="@emoji" Normal="true" />
                            </button>
                        }
                    </div>
                </section>
            }
            <section>
                <header class="_acrylic"><i class="far fa-clock fa-fw"></i> @Localizer.Translate("recentUsed")</header>
                <div class="body">
                    @foreach (string emoji in recentlyUsed)
                    {
                        <button @key="emoji" class="_button item" type="button" @onclick="eventArgs => ChooseWithRipple(emoji, eventArgs)">
                            <MkEmoji CssClass="emoji" Emoji="@emoji" Normal="true" />
                        </button>
                    }
                </div>
            </section>
        </div>
        <div class="group">
            <header class="_acrylic">@Localizer.Translate("customEmojis")</header>
            @foreach (string category in CustomCategories)
            {
                <MkEmojiPickerSection @key="category"
                                      Title="@(string.IsNullOrEmpty(category) ? Localizer.Translate("other") : category)"
                                      Emojis="@CustomEmojiValues(category)"
                                      CustomEmojiUrls="@CustomEmojiUrlMap"
                                      ChosenWithEvent="ShowSectionRipple"
                                      Chosen="Choose" />
            }
        </div>
        <div class="group">
            <header class="_acrylic">@Localizer.Translate("emoji")</header>
            @foreach (string category in Catalog.Categories)
            {
                <MkEmojiPickerSection @key="category"
                                      Title="@category"
                                      Emojis="@UnicodeValues(category)"
                                      ChosenWithEvent="ShowSectionRipple"
                                      Chosen="Choose" />
            }
        </div>
    </div>
    <div class="tabs">
        <button class="_button tab @(tab == "index" ? "active" : null)" type="button" @onclick="SelectIndex"><i class="fas fa-asterisk fa-fw"></i></button>
        <button class="_button tab @(tab == "custom" ? "active" : null)" type="button" @onclick="SelectCustom"><i class="fas fa-laugh fa-fw"></i></button>
        <button class="_button tab @(tab == "unicode" ? "active" : null)" type="button" @onclick="SelectUnicode"><i class="fas fa-leaf fa-fw"></i></button>
        <button class="_button tab @(tab == "tags" ? "active" : null)" type="button" @onclick="SelectTags"><i class="fas fa-hashtag fa-fw"></i></button>
    </div>
</div>
@foreach (EmojiPickerRipple ripple in ripples)
{
    <MkRipple @key="ripple.Id"
              X="ripple.X"
              Y="ripple.Y"
              End="@(() => CloseRipple(ripple.Id))" />
}

@code {
    private static readonly string[] DefaultPinned = ["👍", "❤️", "😆", "🤔", "😮", "🎉", "💢", "😥", "😇", "🍮"];
    private readonly CancellationTokenSource lifetime = new();
    private readonly List<string> recentlyUsed = [];
    private readonly List<UnicodeEmojiDefinition> searchResultUnicode = [];
    private readonly List<EmojiPickerCustomEmoji> searchResultCustom = [];
    private readonly List<EmojiPickerRipple> ripples = [];
    private ElementReference search;
    private ElementReference emojis;
    private DotNetObjectReference<MkEmojiPicker>? receiver;
    private IJSObjectReference? attachment;
    private IReadOnlyList<string> storedPinned = DefaultPinned;
    private string query = string.Empty;
    private string? pendingPastedChoice;
    private string tab = "index";
    private int reactionPickerSize = 1;
    private int reactionPickerWidth = 3;
    private int reactionPickerHeight = 2;
    private bool disableShowingAnimatedImages;
    private bool disposed;

    [Parameter]
    public bool ShowPinned { get; set; } = true;

    [Parameter]
    public bool AsReactionPicker { get; set; }

    [Parameter]
    public double? MaxHeight { get; set; }

    [Parameter]
    public bool AsDrawer { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public IReadOnlyList<string>? Pinned { get; set; }

    [Parameter]
    public IReadOnlyList<EmojiPickerCustomEmoji> CustomEmojis { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<string> Chosen { get; set; }

    private string RootClass => string.Join(' ', new[]
    {
        "omfetrab",
        $"s{(AsReactionPicker ? reactionPickerSize : 1)}",
        $"w{(AsReactionPicker ? reactionPickerWidth : 3)}",
        $"h{(AsReactionPicker ? reactionPickerHeight : 2)}",
        AsDrawer ? "asDrawer" : null,
        CssClass
    }.Where(value => value is not null));

    private string? RootStyle => MaxHeight is null ? null : $"max-height: {MaxHeight.Value:0.###}px";

    private IReadOnlyList<string> EffectivePinned => Pinned ?? storedPinned;

    private IReadOnlyList<string> CustomCategories => CustomEmojis
        .Select(emoji => emoji.Category ?? string.Empty)
        .Distinct(StringComparer.Ordinal)
        .ToArray();

    private IReadOnlyDictionary<string, string> CustomEmojiUrlMap => CustomEmojis.ToDictionary(
        emoji => $":{emoji.Name}:",
        emoji => emoji.Url,
        StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(CustomEmojis);
        if (Pinned is not null && Pinned.Any(string.IsNullOrWhiteSpace))
        {
            throw new ArgumentException("Pinned emojis cannot contain an empty value.", nameof(Pinned));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed)
        {
            return;
        }

        if (!firstRender)
        {
            await ProcessPendingPastedChoiceAsync();
            return;
        }

        receiver = DotNetObjectReference.Create(this);
        try
        {
            IJSObjectReference? created = await EmojiInterop.AttachAsync(
                search,
                emojis,
                receiver,
                lifetime.Token);
            if (disposed)
            {
                if (created is not null)
                {
                    await DisposeAttachmentAsync(created);
                }
                return;
            }
            attachment = created;

            string[] reactions = await DeviceState.ReadAsync(
                "reactions",
                DefaultPinned,
                lifetime.Token);
            storedPinned = reactions.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();
            reactionPickerSize = NormalizeSetting(
                await DeviceState.ReadAsync("reactionPickerSize", 1, lifetime.Token),
                1,
                3,
                1);
            reactionPickerWidth = NormalizeSetting(
                await DeviceState.ReadAsync("reactionPickerWidth", 1, lifetime.Token),
                1,
                5,
                1);
            reactionPickerHeight = NormalizeSetting(
                await DeviceState.ReadAsync("reactionPickerHeight", 2, lifetime.Token),
                1,
                4,
                2);
            disableShowingAnimatedImages = await DeviceState.ReadAsync(
                "disableShowingAnimatedImages",
                false,
                lifetime.Token);
            string[] values = await DeviceState.ReadAsync(
                "recentlyUsedEmojis",
                Array.Empty<string>(),
                lifetime.Token);
            recentlyUsed.Clear();
            recentlyUsed.AddRange(values.Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.Ordinal).Take(32));
            await FocusAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JsonException)
        {
            recentlyUsed.Clear();
        }
    }

    private static int NormalizeSetting(int value, int minimum, int maximum, int fallback) =>
        value >= minimum && value <= maximum ? value : fallback;

    private async Task SearchChanged(ChangeEventArgs args)
    {
        query = args.Value?.ToString()?.Trim() ?? string.Empty;
        ApplySearch();
        await ResetScrollAsync();
    }

    private async Task SearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _ = await ChooseSearchResultAsync();
        }
    }

    [JSInvokable]
    public async Task<bool> NotifyPasted(string value)
    {
        if (disposed || pendingPastedChoice is not null)
        {
            return false;
        }

        string? choice = ResolveSearchChoice(value);
        if (choice is null)
        {
            return false;
        }

        // A JS-to-.NET invocation cannot safely await a selection: selection can close the
        // dialog and persist recents through JS interop.  Schedule it for the next rendered
        // frame, after this invocation has replied to the browser.
        pendingPastedChoice = choice;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task<bool> ChooseSearchResultAsync(string? value = null)
    {
        string? choice = ResolveSearchChoice(value ?? query);
        if (choice is null)
        {
            return false;
        }

        await Choose(choice);
        return true;
    }

    private string? ResolveSearchChoice(string candidate)
    {
        if (string.IsNullOrEmpty(candidate))
        {
            return null;
        }

        string normalized = candidate.Replace(":", string.Empty, StringComparison.Ordinal);
        EmojiPickerCustomEmoji? custom = CustomEmojis.FirstOrDefault(emoji => emoji.Name == normalized);
        if (custom is not null)
        {
            return $":{custom.Name}:";
        }

        UnicodeEmojiDefinition? unicode = Catalog.Emojis.FirstOrDefault(emoji => emoji.Value == normalized || emoji.Name == normalized);
        if (unicode is not null)
        {
            return unicode.Value;
        }

        if (searchResultCustom.Count > 0)
        {
            return $":{searchResultCustom[0].Name}:";
        }

        return searchResultUnicode.Count > 0 ? searchResultUnicode[0].Value : null;
    }

    private async Task ProcessPendingPastedChoiceAsync()
    {
        if (pendingPastedChoice is not { } choice || disposed)
        {
            return;
        }

        pendingPastedChoice = null;
        await Choose(choice);
    }

    private void ApplySearch()
    {
        searchResultCustom.Clear();
        searchResultUnicode.Clear();
        if (query.Length == 0)
        {
            return;
        }

        string normalized = query.Replace(":", string.Empty, StringComparison.Ordinal);
        searchResultCustom.AddRange(SearchCustom(normalized).Take(8));
        searchResultUnicode.AddRange(SearchUnicode(normalized).Take(8));
    }

    private IEnumerable<EmojiPickerCustomEmoji> SearchCustom(string value) => Search(
        CustomEmojis,
        value,
        emoji => emoji.Name,
        emoji => emoji.Aliases);

    private IEnumerable<UnicodeEmojiDefinition> SearchUnicode(string value) => Search(
        Catalog.Emojis,
        value,
        emoji => emoji.Name,
        emoji => emoji.Keywords);

    private static IEnumerable<T> Search<T>(
        IReadOnlyList<T> values,
        string queryValue,
        Func<T, string> name,
        Func<T, IReadOnlyList<string>> aliases)
        where T : class
    {
        var matches = new HashSet<T>();
        T? exact = values.FirstOrDefault(value => name(value) == queryValue);
        if (exact is not null)
        {
            matches.Add(exact);
            yield return exact;
        }

        string[] keywords = queryValue.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        IEnumerable<T>[] passes = keywords.Length > 1
            ?
            [
                values.Where(value => keywords.All(keyword => name(value).Contains(keyword, StringComparison.Ordinal))),
                values.Where(value => keywords.All(keyword =>
                    name(value).Contains(keyword, StringComparison.Ordinal) ||
                    aliases(value).Any(alias => alias.Contains(keyword, StringComparison.Ordinal))))
            ]
            :
            [
                values.Where(value => name(value).StartsWith(queryValue, StringComparison.Ordinal)),
                values.Where(value => aliases(value).Any(alias => alias.StartsWith(queryValue, StringComparison.Ordinal))),
                values.Where(value => name(value).Contains(queryValue, StringComparison.Ordinal)),
                values.Where(value => aliases(value).Any(alias => alias.Contains(queryValue, StringComparison.Ordinal)))
            ];
        foreach (IEnumerable<T> pass in passes)
        {
            foreach (T value in pass)
            {
                if (matches.Add(value))
                {
                    yield return value;
                    if (matches.Count >= 8)
                    {
                        yield break;
                    }
                }
            }
        }
    }

    private async Task Choose(string value)
    {
        await Chosen.InvokeAsync(value);
        if (EffectivePinned.Contains(value, StringComparer.Ordinal))
        {
            return;
        }

        recentlyUsed.RemoveAll(emoji => string.Equals(emoji, value, StringComparison.Ordinal));
        recentlyUsed.Insert(0, value);
        if (recentlyUsed.Count > 32)
        {
            recentlyUsed.RemoveRange(32, recentlyUsed.Count - 32);
        }

        try
        {
            await DeviceState.WriteAsync("recentlyUsedEmojis", recentlyUsed.ToArray(), lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task ChooseCustom(EmojiPickerCustomEmoji emoji, MouseEventArgs eventArgs) =>
        ChooseWithRipple($":{emoji.Name}:", eventArgs);

    private async Task ChooseWithRipple(string value, MouseEventArgs eventArgs)
    {
        ShowRipple(eventArgs);
        await Choose(value);
    }

    private void ShowSectionRipple(EmojiPickerChosenEvent selection) => ShowRipple(selection.Event);

    private void ShowRipple(MouseEventArgs eventArgs)
    {
        if (!double.IsFinite(eventArgs.ClientX) || !double.IsFinite(eventArgs.ClientY))
        {
            return;
        }
        ripples.Add(new(Guid.NewGuid(), eventArgs.ClientX, eventArgs.ClientY));
    }

    private void CloseRipple(Guid id) => ripples.RemoveAll(ripple => ripple.Id == id);

    private string SelectCustomImageUrl(string url) => disableShowingAnimatedImages
        ? AppendStaticQuery(url)
        : url;

    private static string AppendStaticQuery(string url) =>
        url.Contains('?', StringComparison.Ordinal) ? url + "&static=1" : url + "?static=1";

    public async Task FocusAsync()
    {
        try
        {
            await EmojiInterop.FocusAsync(search, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async Task ResetAsync()
    {
        query = string.Empty;
        searchResultCustom.Clear();
        searchResultUnicode.Clear();
        await InvokeAsync(StateHasChanged);
        await ResetScrollAsync();
    }

    private async Task ResetScrollAsync()
    {
        try
        {
            await EmojiInterop.ResetAsync(emojis, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void SelectIndex() => tab = "index";
    private void SelectCustom() => tab = "custom";
    private void SelectUnicode() => tab = "unicode";
    private void SelectTags() => tab = "tags";

    private IReadOnlyList<string> UnicodeValues(string category) => Catalog.Emojis
        .Where(emoji => emoji.Category == category)
        .Select(emoji => emoji.Value)
        .ToArray();

    private IReadOnlyList<string> CustomEmojiValues(string category) => CustomEmojis
        .Where(emoji => string.Equals(emoji.Category ?? string.Empty, category, StringComparison.Ordinal))
        .Select(emoji => $":{emoji.Name}:")
        .ToArray();

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        await lifetime.CancelAsync();
        if (attachment is not null)
        {
            await DisposeAttachmentAsync(attachment);
        }
        receiver?.Dispose();
        lifetime.Dispose();
    }

    private static async ValueTask DisposeAttachmentAsync(IJSObjectReference handle)
    {
        try
        {
            await handle.InvokeVoidAsync("dispose");
            await handle.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record EmojiPickerRipple(Guid Id, double X, double Y);
}
