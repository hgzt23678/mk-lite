@implements IDisposable
@inject IMisskeyLocalizer Localizer

<div class="@RootClass" @attributes="AttributesWithoutClass">
    <div class="label" @onclick="FocusAsync">@Label</div>
    <div class="@InputClass">
        <textarea @ref="inputElement"
                  value="@currentValue"
                  class="@TextareaClass"
                  disabled="@Disabled"
                  required="@Required"
                  readonly="@ReadOnly"
                  placeholder="@Placeholder"
                  pattern="@Pattern"
                  autocomplete="@Autocomplete"
                  spellcheck="@SpellcheckText"
                  @onfocus="OnFocus"
                  @onblur="OnBlur"
                  @onkeydown="OnKeyDownAsync"
                  @oninput="OnInputAsync"></textarea>
    </div>
    <div class="caption">@Caption</div>

    @if (ManualSave && changed)
    {
        <MkButton Primary="true" CssClassAdditional="save" OnClick="SaveAsync">
            <i class="fas fa-save"></i> @Localizer.Translate("save")
        </MkButton>
    }
</div>

@code {
    private ElementReference inputElement;
    private CancellationTokenSource? debounce;
    private string currentValue = string.Empty;
    private string? lastIncomingValue;
    private bool focused;
    private bool changed;
    private bool disposed;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> Changed { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> KeyDown { get; set; }

    [Parameter]
    public EventCallback Entered { get; set; }

    [Parameter]
    public RenderFragment? Label { get; set; }

    [Parameter]
    public RenderFragment? Caption { get; set; }

    // Misskey 12.119.2 declares this prop but does not use it in the rendered textarea.
    [Parameter]
    public string? Type { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Pattern { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Autofocus { get; set; }

    [Parameter]
    public string? Autocomplete { get; set; }

    [Parameter]
    public bool? Spellcheck { get; set; }

    [Parameter]
    public bool Code { get; set; }

    [Parameter]
    public bool Tall { get; set; }

    [Parameter]
    public bool Pre { get; set; }

    [Parameter]
    public bool Debounce { get; set; }

    [Parameter]
    public bool ManualSave { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => string.Join(' ', new[] { "adhpbeos", AdditionalClass }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string InputClass => string.Join(' ', new[]
    {
        "input",
        Disabled ? "disabled" : null,
        focused ? "focused" : null,
        Tall ? "tall" : null,
        Pre ? "pre" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? TextareaClass => Code ? "code _monospace" : null;

    private string? SpellcheckText => Spellcheck switch
    {
        true => "true",
        false => "false",
        null => null
    };

    private string? AdditionalClass =>
        AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out object? value)
            ? Convert.ToString(value, CultureInfo.InvariantCulture)
            : null;

    private IReadOnlyDictionary<string, object>? AttributesWithoutClass => AdditionalAttributes is null
        ? null
        : AdditionalAttributes
            .Where(attribute => !string.Equals(attribute.Key, "class", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(attribute => attribute.Key, attribute => attribute.Value, StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (!string.Equals(lastIncomingValue, Value, StringComparison.Ordinal))
        {
            currentValue = Value;
            lastIncomingValue = Value;
            changed = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Autofocus && !disposed)
        {
            try
            {
                await inputElement.FocusAsync(preventScroll: true);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private Task OnFocus(FocusEventArgs args)
    {
        focused = true;
        return Task.CompletedTask;
    }

    private Task OnBlur(FocusEventArgs args)
    {
        focused = false;
        return Task.CompletedTask;
    }

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        currentValue = args.Value?.ToString() ?? string.Empty;
        changed = true;
        await Changed.InvokeAsync(args);

        if (ManualSave)
        {
            return;
        }

        if (!Debounce)
        {
            await PublishAsync();
            return;
        }

        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();
        CancellationToken token = debounce.Token;
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1), token);
            await PublishAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        await KeyDown.InvokeAsync(args);
        if (string.Equals(args.Code, "Enter", StringComparison.Ordinal))
        {
            await Entered.InvokeAsync();
        }
    }

    private Task SaveAsync(MouseEventArgs args) => PublishAsync();

    private async Task PublishAsync()
    {
        changed = false;
        lastIncomingValue = currentValue;
        await ValueChanged.InvokeAsync(currentValue);
    }

    private async Task FocusAsync(MouseEventArgs args)
    {
        try
        {
            await inputElement.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        disposed = true;
        debounce?.Cancel();
        debounce?.Dispose();
    }
}
