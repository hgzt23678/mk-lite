@implements IAsyncDisposable
@inject IUserPreviewInterop Browser
@inject IMisskeyOverlayService Overlays
@inject ILogger<UserPreviewDirectiveHost> Logger

@code {
    private readonly CancellationTokenSource lifetime = new();
    private DotNetObjectReference<UserPreviewDirectiveHost>? receiver;
    private IJSObjectReference? attachment;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed)
        {
            return;
        }

        receiver = DotNetObjectReference.Create(this);
        try
        {
            IJSObjectReference created = await Browser.AttachDirectiveHostAsync(receiver, lifetime.Token);
            if (disposed)
            {
                await created.InvokeVoidAsync("dispose");
                await created.DisposeAsync();
            }
            else
            {
                attachment = created;
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task ShowUserPreviewAsync(
        string hostId,
        string sourceId,
        string query,
        long generation)
    {
        if (disposed)
        {
            return Task.CompletedTask;
        }

        try
        {
            _ = Overlays.ShowUserPreview(hostId, sourceId, query, generation);
        }
        catch (ArgumentException exception)
        {
            Logger.LogWarning(exception, "Rejected an invalid user preview request with {ErrorCode}.", "USER_PREVIEW_REQUEST_INVALID");
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task HideUserPreviewAsync(string hostId, string sourceId, long generation)
    {
        if (!disposed)
        {
            _ = Overlays.HideUserPreview(hostId, sourceId, generation);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        await lifetime.CancelAsync();
        if (attachment is not null)
        {
            try
            {
                await attachment.InvokeVoidAsync("dispose");
                await attachment.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        receiver?.Dispose();
        lifetime.Dispose();
    }
}
