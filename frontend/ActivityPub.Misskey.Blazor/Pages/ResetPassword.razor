@page "/reset-password"
@page "/reset-password/{Token?}"
@implements IAsyncDisposable
@inject IPasswordResetFormInterop PasswordResetInterop
@inject IMisskeyOverlayService Overlays
@inject NavigationManager Navigation
@inject IMisskeyLocalizer Localizer

<PageTitle>@Localizer.Translate("resetPassword")</PageTitle>

<MkStickyContainer>
    <Header><MkPageHeader Title="@Localizer.Translate("resetPassword")" Icon="fas fa-lock" /></Header>
    <ChildContent>
        <MkSpacer ContentMax="700" MarginMin="16" MarginMax="32">
            <form @ref="formElement"
                  class="_formRoot"
                  method="post"
                  action="/auth/password-reset/complete"
                  autocomplete="new-password">
                <AntiforgeryToken />
                <input type="hidden" name="resetToken" value="" />
                @if (FailureMessage is string failureMessage)
                {
                    <MkInfo Warn="true" CssClassAdditional="_formBlock">@failureMessage</MkInfo>
                }
                <MkFormInput CssClassAdditional="_formBlock"
                             Name="password"
                             Type="password"
                             Autocomplete="new-password"
                             Required="true"
                             MaxLength="1024"
                             ServerBound="false">
                    <Prefix><i class="fas fa-lock"></i></Prefix>
                    <Label>@Localizer.Translate("newPassword")</Label>
                </MkFormInput>
                <MkButton CssClassAdditional="_formBlock"
                          Type="submit"
                          Primary="true"
                          Disabled="@(!tokenReady)"
                          data-password-reset-submit="true"
                          data-default-label="@SaveLabel"
                          data-pending-label="@SaveLabel">
                    @SaveLabel
                </MkButton>
            </form>
        </MkSpacer>
    </ChildContent>
</MkStickyContainer>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private ElementReference formElement;
    private DotNetObjectReference<ResetPassword>? receiver;
    private IJSObjectReference? attachment;
    private string? failureMessageKey;
    private bool tokenReady;
    private bool disposed;

    [CascadingParameter(Name = "MisskeyLocaleRevision")]
    private long LocaleRevision { get; set; }

    [Parameter]
    public string? Token { get; set; }

    private string SaveLabel => Localizer.Translate("save");

    private string? FailureMessage => failureMessageKey is null ? null : Localizer.Translate(failureMessageKey);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        receiver = DotNetObjectReference.Create(this);
        try
        {
            attachment = await PasswordResetInterop.AttachCompletionAsync(formElement, receiver, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task NotifyTokenReady()
    {
        tokenReady = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifyMissingToken()
    {
        Overlays.ShowForgotPassword();
        Navigation.NavigateTo("", new NavigationOptions { ReplaceHistoryEntry = true });
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task NotifyResetSucceeded()
    {
        tokenReady = false;
        failureMessageKey = null;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task NotifyResetFailure(string safeErrorCode)
    {
        string key = safeErrorCode switch
        {
            "PASSWORD_TOO_SHORT" => "tooShort",
            "PASSWORD_REQUIRES_SYMBOL" or
            "PASSWORD_REQUIRES_DIGIT" or
            "PASSWORD_REQUIRES_LOWERCASE" or
            "PASSWORD_REQUIRES_UPPERCASE" or
            "PASSWORD_REQUIRES_UNIQUE_CHARACTERS" or
            "INVALID_OR_EXPIRED_TOKEN" => "invalidValue",
            _ => "error"
        };
        failureMessageKey = key;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        await lifetime.CancelAsync();
        if (attachment is not null)
        {
            try
            {
                await attachment.InvokeVoidAsync("dispose");
                await attachment.DisposeAsync();
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }
        receiver?.Dispose();
        lifetime.Dispose();
    }
}
